# --- API keys (required for live runs; tests use fakes) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Database ---
DATABASE_URL=postgresql+asyncpg://council:council@localhost:5432/council

# --- Model tiers (override as new models ship) ---
OPENAI_MODEL_FLAGSHIP=gpt-5.1
OPENAI_MODEL_CHEAP=gpt-5-mini
ANTHROPIC_MODEL_FLAGSHIP=claude-sonnet-4-5
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5

# --- Behavior ---
# Provider used for the combined check + synthesis (cheap tier): openai | anthropic
CHECK_PROVIDER=openai
# Quick mode strategy: alternate | openai | anthropic
QUICK_MODE_STRATEGY=alternate
REQUEST_TIMEOUT_SECONDS=120
