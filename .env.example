# --- API keys (required for live runs; tests use fakes) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Database ---
DATABASE_URL=postgresql+asyncpg://council:council@localhost:5432/council

# --- Model tiers (override as new models ship) ---
OPENAI_MODEL_FLAGSHIP=gpt-5.6-sol
OPENAI_MODEL_CHEAP=gpt-5.6-luna
ANTHROPIC_MODEL_FLAGSHIP=claude-sonnet-5
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5

# --- Behavior ---
# Provider used for the combined check + synthesis (cheap tier): openai | anthropic
CHECK_PROVIDER=openai
# Provider whose flagship judges disagreements; the OTHER provider verifies.
JUDGE_PROVIDER=anthropic
# Quick mode strategy: alternate | openai | anthropic
QUICK_MODE_STRATEGY=alternate
REQUEST_TIMEOUT_SECONDS=120

# --- Evidence layer (deep mode only in V1) ---
# Web retrieval: tavily | brave | none. With 'none' (or no key) web evidence
# reports itself unavailable and the system preserves uncertainty rather than
# falling back to model opinion.
EVIDENCE_SEARCH_PROVIDER=none
TAVILY_API_KEY=
BRAVE_API_KEY=
# Sandboxed code execution. Runs model-written Python in an isolated process
# with a fresh temp dir, scrubbed env, timeout and (on Linux/macOS) rlimits.
# It is a blast-radius limiter, not a security boundary — set false to disable.
EVIDENCE_CODE_EXECUTION=true
EVIDENCE_CODE_TIMEOUT_SECONDS=15
MAX_WEB_SEARCHES=3
MAX_CODE_EXECUTIONS=2
